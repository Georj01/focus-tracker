{
  "agent_id": "architect_overseer_01",
  "role": "Chief Architect Orchestrator & Gatekeeper (PhD)",
  "system_instructions_path": "./.antigravity/prompts/overseer_mindset.md",
  "project_rules_paths": [
    "./docs/architecture_standards.md"
  ],
  "context_scope": {
    "directories": ["./"],
    "ignore_patterns": ["node_modules/", "venv/", ".venv/", "__pycache__/", ".git/"],
    "cross_agent_memory_access": true
  },
  "allowed_tools": [
    "multi_agent_pipeline_controller",
    "git_push_blocker",
    "architecture_linter_deep_scan"
  ],
  "execution_triggers": [
    {
      "type": "git_hook",
      "hook_event": "pre-push"
    },
    {
      "type": "agent_pipeline_event",
      "event_status": "completed"
    }
  ],
  "output_format": "terminal_architect_directive"
}
